# ---------- 控制台 ----------
APP_ADDR=127.0.0.1:8787
# 对外的控制台地址；上传图片和机器人按钮会用到它
PUBLIC_URL=http://127.0.0.1:8787

# ---------- Telegram ----------
# 在 @BotFather 创建机器人后填写；留空则进入演示模式
BOT_TOKEN=
# 机器人必须已在群内并被设为管理员
# 关闭 BotFather 的 Privacy Mode 才能拦截所有群消息

# ---------- 管理员 ----------
# 首次启动时创建；已有数据库时不会覆盖
ADMIN_USER=admin
ADMIN_PASSWORD=admin123
# 生产环境请改为随机长字符串
SESSION_SECRET=change-me-to-a-random-long-string

# ---------- 数据 ----------
DB_PATH=data/starkeeper.db
UPLOAD_DIR=data/uploads
APP_TIMEZONE=Asia/Shanghai
# 留空 = 自动：无 BOT_TOKEN 时写入演示数据，有 Token 时不写入
# 生产环境也可显式设为 false
SEED_DEMO=
